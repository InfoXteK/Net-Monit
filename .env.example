# =============================================================================
# Net-monit V11.3 — Environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values for YOUR deployment.
# `.env` (without the .example suffix) should be in your .gitignore and
# NEVER committed — this .example file is safe to commit precisely because
# it contains no real values, only placeholders and documentation.
#
# IMPORTANT: Net-monit does not currently auto-load a .env file itself (no
# python-dotenv dependency). These variables are read directly from the
# process environment via os.environ.get(), so your process manager needs
# to supply them:
#   - systemd:        add `EnvironmentFile=/opt/netmonit-v113/.env` under
#                      [Service] in netmonit-v113.service, or individual
#                      `Environment=KEY=value` lines.
#   - Windows service: set via the service's environment, or a wrapper
#                       script that exports these before launching
#                       install_service.py.
#   - Docker:          use `env_file: .env` in docker-compose, or `--env-file`
#                       with `docker run`.
#   - Manual/dev:       `export $(grep -v '^#' .env | xargs)` before running
#                        app.py, or use a tool like `direnv`.
#
# Every one of these is OPTIONAL — the app has a working default for each
# and will run fine with none of this file present at all. Set only what
# you actually need to override.
# =============================================================================

# --- Network ---
# Port the Flask app listens on. Default: 50113 (V11.3's version-derived
# port -- see the Claude Reference doc before changing this convention).
NETMON_PORT=50113

# --- TLS (optional -- omit both to serve plain HTTP, which is fine for a
#     LAN-only deployment behind your own firewall) ---
# Absolute paths to a PEM certificate + private key if you want Net-monit
# to serve HTTPS directly rather than sitting behind a reverse proxy.
NETMON_SSL_CERT=
NETMON_SSL_KEY=

# --- Session security ---
# Flask's session-signing secret. If unset, the app generates a random one
# at every startup -- which means every existing login session is
# invalidated on every restart. Set this to a fixed, random value (e.g.
# `python3 -c "import secrets; print(secrets.token_hex(32))"`) if you want
# sessions to survive a service restart. Treat this like a password: never
# commit a real value, never reuse it across environments.
NETMON_SECRET=

# --- SMTP ---
# Overrides just the SMTP password from config.yaml, so you can keep the
# rest of your SMTP settings (host, port, from-address, recipient lists) in
# config.yaml under version control while keeping the actual password out
# of it entirely. Leave unset to use whatever password is saved in
# config.yaml / entered through Settings -> SMTP in the UI.
NETMON_SMTP_PASSWORD=

# --- Windows service identity (install_service.py only, Windows hosts) ---
# Only relevant if you're customizing the Windows service registration
# itself (e.g. running multiple independent instances on one machine,
# which would need distinct service names). Leave unset for the standard
# single-instance install.
NETMON_SVC_NAME=
NETMON_SVC_DISPLAY=
